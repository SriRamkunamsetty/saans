# Copy to .env.local for local development. Never commit real keys.
#
# Optional. Without a key the app still works end to end: the deterministic
# rules engine produces the whole plan and a rule-based summary.
# Get a key at https://aistudio.google.com/apikey and add it in Vercel
# (Project > Settings > Environment Variables) as a *server-side* variable.
GEMINI_API_KEY=

# Optional overrides (defaults shown).
GEMINI_MODEL=gemini-3.8-flash
AI_TIMEOUT_MS=8000
RATE_LIMIT_PER_MINUTE=20
