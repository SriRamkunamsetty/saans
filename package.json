{
  "name": "saans",
  "version": "1.0.0",
  "description": "A GenAI urban air quality assistant built with Next.js, TypeScript, Gemini API & Open-Meteo. Turns live smog data into a personalised, explainable plan for families and communities.",
  "author": "SriRam Kunamsetty <mohansriramkunamsetty@gmail.com>",
  "private": true,
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test:coverage && npm run build"
  },
  "dependencies": {
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "^16.4.6",
    "jest-axe": "^11.0.0",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
